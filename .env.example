# ==============================================================================
# ERETO NAMUNYAK CBO - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
APP_URL=http://localhost:5000
SESSION_SECRET=

# Database Configuration (Supabase PostgreSQL)
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# When DATABASE_URL or SUPABASE_URL is provided, the system seamlessly connects to Supabase PostgreSQL.
# If not yet set, the built-in database adapter automatically provides a local SQLite database for instant zero-error development.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Pesapal Payment Gateway v3 Configuration
# Test sandbox credentials can be obtained from: https://developer.pesapal.com/
PESAPAL_CONSUMER_KEY=demo_pesapal_consumer_key
PESAPAL_CONSUMER_SECRET=demo_pesapal_consumer_secret
PESAPAL_ENVIRONMENT=sandbox
PESAPAL_IPN_ID=
PESAPAL_CALLBACK_URL=http://localhost:5000/payment-callback.html
PESAPAL_IPN_URL=http://localhost:5000/api/donations/pesapal-ipn

# Email Notification Service (Nodemailer)
# Use your SMTP server or Ethereal for testing
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Ereto Namunyak CBO" <info@eretonamunyak.org>

# Initial Super Administrator Setup
# Used by 'npm run seed:admin' to create the initial master account securely
INITIAL_ADMIN_NAME=Ereto Super Admin
INITIAL_ADMIN_EMAIL=admin@eretonamunyak.org
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_ROLE=super_admin
INITIAL_ADMIN_PHONE=+254722000000
